{
  "name": "cafeteria-origen",
  "version": "1.0.0",
  "private": true,
  "description": "Cafetería Origen — sitio web + API para el práctico de Ciberseguridad (OWASP Top 10) - Programación IV",
  "main": "src/server.ts",
  "scripts": {
    "start": "node --import tsx src/server.ts",
    "dev": "node --import tsx --watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 tests/productos.test.ts tests/pedidos.test.ts tests/auth.test.ts tests/reportes.test.ts",
    "test:seguridad": "node --import tsx --test --test-concurrency=1 tests/seguridad.test.ts tests/seguridad-login.test.ts tests/seguridad-fuerza-bruta.test.ts",
    "test:todo": "node --import tsx --test --test-concurrency=1 \"tests/*.test.ts\"",
    "check:security": "node --import tsx scripts/check-security.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "pg": "^8.12.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "typescript": "^5.7.2"
  }
}
